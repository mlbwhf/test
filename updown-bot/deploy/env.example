# ~/updown/.env on the VPS. Paper mode unless UPDOWN_MODE=live.
UPDOWN_MODE=paper
UPDOWN_PERIOD=900
UPDOWN_MIN_EDGE=0.04
UPDOWN_MAX_STAKE=25
UPDOWN_BANKROLL=1000
UPDOWN_MAX_DAILY_LOSS=100
UPDOWN_CALIB_HOURS=48
UPDOWN_CALIB_EVERY=24
