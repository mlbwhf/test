{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Report AI — AI Index palette",
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "contrast", "color": "#0e2f56", "name": "Contrast / Deep Network Blue" },
        { "slug": "charcoal-blue", "color": "#0e2f56", "name": "Deep Network Blue (Nodes)" },
        { "slug": "circuit-blue", "color": "#4a90e2", "name": "Data Flow Blue" },
        { "slug": "insight-orange", "color": "#e67e22", "name": "Insight Orange (Data Points)" },
        { "slug": "surface", "color": "#f5f8fc", "name": "Surface" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif",
          "slug": "system-font",
          "name": "Analytical Sans (Inter)"
        }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system-font)" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--circuit-blue)" } },
      "h1": { "color": { "text": "var(--wp--preset--color--charcoal-blue)" } },
      "h2": { "color": { "text": "var(--wp--preset--color--charcoal-blue)" } },
      "h3": { "color": { "text": "var(--wp--preset--color--charcoal-blue)" } }
    }
  }
}
