# Trainyard web app. Build from the trainyard/ directory:
#   docker build -f infra/docker/Dockerfile.web --build-arg API_URL=https://api.example.com -t trainyard-web .
# The API URL is baked in at build time because the browser calls it directly.
FROM node:25-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
ARG API_URL=http://localhost:4100
ENV NEXT_PUBLIC_TRAINYARD_API_URL=$API_URL NEXT_TELEMETRY_DISABLED=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter @trainyard/web... \
 && pnpm --filter @trainyard/web... run build

FROM node:25-alpine
ENV NODE_ENV=production PORT=3100 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3100
CMD ["node", "apps/web/server.js"]
