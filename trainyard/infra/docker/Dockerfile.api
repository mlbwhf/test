# Trainyard API. Build from the trainyard/ directory:
#   docker build -f infra/docker/Dockerfile.api -t trainyard-api .
FROM node:25-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile --filter @trainyard/api... \
 && pnpm --filter @trainyard/api... run build \
 && pnpm --filter @trainyard/api --prod deploy --legacy /out

FROM node:25-alpine
ENV NODE_ENV=production TRAINYARD_ENV=production PORT=4100
WORKDIR /app
COPY --from=build /out .
USER node
EXPOSE 4100
# 127.0.0.1, not localhost: Alpine resolves localhost to ::1 first and the API listens on IPv4.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=4 CMD wget -qO- http://127.0.0.1:4100/health || exit 1
CMD ["node", "dist/main.js"]
