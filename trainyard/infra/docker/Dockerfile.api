# Trainyard API. Build from the trainyard/ directory:
#   docker build -f infra/docker/Dockerfile.api -t trainyard-api .
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile --filter @trainyard/api... \
 && pnpm --filter @trainyard/api... run build \
 && pnpm --filter @trainyard/api --prod deploy --legacy /out

FROM node:22-alpine
ENV NODE_ENV=production TRAINYARD_ENV=production PORT=4100
WORKDIR /app
COPY --from=build /out .
USER node
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:4100/health || exit 1
CMD ["node", "dist/main.js"]
