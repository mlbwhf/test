# Copy to /opt/trainyard/.env on the VPS. Never commit the real file.
# Values marked (secret) live in your password manager; GitHub only needs the DEPLOY_* secrets.
# Keep comments on their own lines: Compose reads everything after "=" as the value.

# ---- Domain and Traefik ----
# Web at plan.<domain>, API at plan-api.<domain>, unless the two hosts below are set.
TRAINYARD_DOMAIN=agile-agilist.com
# Optional overrides, e.g. trainyard.example.com and api.trainyard.example.com
TRAINYARD_WEB_HOST=
TRAINYARD_API_HOST=
# infra/scripts/detect-traefik.sh prints the right values (same as /opt/gate/.env)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# ---- Images (set by the deploy pipeline; defaults pull :latest) ----
TRAINYARD_API_IMAGE=ghcr.io/mlbwhf/trainyard-api:latest
TRAINYARD_WEB_IMAGE=ghcr.io/mlbwhf/trainyard-web:latest

# ---- Database ----
# (secret) openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Access ----
# (secret) openssl rand -hex 32; sign in with it once, then create users
TRAINYARD_ADMIN_KEY=
# (secret) openssl rand -hex 24; Jira/ADO webhooks call /v1/webhooks/<system>?token=<this>
TRAINYARD_WEBHOOK_SECRET=

# ---- AI assistance: pick one, or leave both empty to run without it ----
# (secret) Claude: best drafts, paid per use
ANTHROPIC_API_KEY=
TRAINYARD_AI_MODEL=claude-opus-5-5
# "llm" starts Ollama on this VPS (free, local, slower); deploy.sh adds --profile llm.
# Leave empty on a KVM2 shared with EnrollClass: deploy.sh refuses it without 1 GB headroom,
# and inference takes most of the CPU while a draft is being written.
LLM_PROFILE=
# http://ollama:11434/v1 with the profile above, or any OpenAI-compatible server
TRAINYARD_LLM_URL=
# qwen2.5:3b fits next to gate on a KVM2; qwen2.5:7b needs about 6 GB of free RAM
TRAINYARD_LLM_MODEL=qwen2.5:3b
# (secret) only for hosted OpenAI-compatible services
TRAINYARD_LLM_KEY=
OLLAMA_MEMORY_LIMIT=3g
# CPU cores Ollama may use; the rest stays with gate and the Trainyard API
OLLAMA_CPUS=1

# ---- Trackers (JSON mapping plus a secret each; see README "Tracker mappings") ----
TRAINYARD_JIRA=
# (secret)
JIRA_API_TOKEN=
TRAINYARD_ADO=
# (secret)
ADO_PAT=
TRAINYARD_SYNC_EVERY_MINUTES=15

# ---- Backups (enable by setting BACKUP_S3_BUCKET; deploy.sh adds --profile backup) ----
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
# (secret) encrypts dumps at rest; keep a copy offline
BACKUP_PASSPHRASE=
# e.g. https://<account>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=trainyard/postgres
# (secret)
BACKUP_S3_ACCESS_KEY_ID=
# (secret)
BACKUP_S3_SECRET_ACCESS_KEY=
