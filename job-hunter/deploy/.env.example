# Copy to .env and fill in. Never commit .env.

# The address the app will live at. Point a DNS A record for it at this server first.
JOBHUNTER_HOST=jobs.example.com

# Password for the web app. Use a long one; it protects your resume.
JOBHUNTER_PASSWORD=

# Optional. A long random string. Lets your own computer send LinkedIn/Indeed/Bayt postings here,
# and lets an automation tool start a search:  POST /api/run  with header  Authorization: Bearer <token>
JOBHUNTER_TOKEN=

# Hour of the day (UTC) for the automatic daily search.
JOBHUNTER_RUN_HOUR=2

# Free API keys (see README). Leave empty to skip those sources.
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Traefik names on this server. Find them with the detect-traefik.sh script from gate-platform/infra/scripts.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
