# Copy to /opt/gate/.env on the VPS. Never commit the real file.
# Values marked (secret) live in your password manager and GitHub repository secrets.

# ---- Domain and Traefik ----
GATE_DOMAIN=enrollclass.com             # api.enrollclass.com and app.enrollclass.com must point at this VPS
TRAEFIK_NETWORK=traefik                 # infra/scripts/detect-traefik.sh prints the right values
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# ---- Images (set by the deploy pipeline; defaults pull :latest) ----
GATE_API_IMAGE=ghcr.io/mlbwhf/gate-api:latest
GATE_WEB_IMAGE=ghcr.io/mlbwhf/gate-web:latest

# ---- Database ----
POSTGRES_PASSWORD=                      # (secret) openssl rand -hex 24

# ---- Platform keys ----
GATE_ADMIN_KEY=                         # (secret) openssl rand -hex 32; creates organizations via x-admin-key
GATE_ORG_API_KEY=                       # (secret) optional: an organization API key for your own integrations
GATE_TICKET_SECRET=                     # (secret) openssl rand -hex 32; signs ticket links and QR codes. Changing it
                                        # invalidates every issued ticket. Blank = derived from GATE_ADMIN_KEY.

# ---- Sign-in (each provider is on once both values are set) ----
# Redirect URI to register with each provider: https://api.<GATE_DOMAIN>/auth/<provider>/callback
# Email sign-in links are on whenever RESEND_API_KEY is set.
GOOGLE_CLIENT_ID=                       # console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
GOOGLE_CLIENT_SECRET=                   # (secret)
MICROSOFT_CLIENT_ID=                    # entra.microsoft.com > App registrations; "any org + personal accounts"
MICROSOFT_CLIENT_SECRET=                # (secret)
LINKEDIN_CLIENT_ID=                     # linkedin.com/developers > app > product "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_SECRET=                 # (secret)
FACEBOOK_CLIENT_ID=                     # developers.facebook.com > app > Facebook Login (needs privacy + data deletion URLs)
FACEBOOK_CLIENT_SECRET=                 # (secret)
EVENTBRITE_CLIENT_ID=                   # eventbrite.com/platform > API keys > OAuth redirect URI
EVENTBRITE_CLIENT_SECRET=               # (secret)

# ---- Stripe (test keys first; swap to live after Connect platform approval) ----
STRIPE_SECRET_KEY=                      # (secret) sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=                  # (secret) whsec_... for https://api.<domain>/v1/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=          # (secret) whsec_... of a second endpoint, same URL, "Events on Connected accounts": account.updated
STRIPE_PUBLISHABLE_KEY=                 # pk_test_... or pk_live_... (shown to browsers, not secret)

# ---- Email (Resend) ----
RESEND_API_KEY=                         # (secret)
EMAIL_FROM=Agile Agilist <training@agile-agilist.com>
EMAIL_FROM_NAME=Agile Agilist
EMAIL_REPLY_TO=training@agile-agilist.com
GATE_ORGANIZER_EMAIL=training@agile-agilist.com
GATE_COURSE_PAGE_URL=https://agile-agilist.com/training/{slug}/

# ---- AI gateway ----
ANTHROPIC_API_KEY=                      # (secret)
GATE_AI_DEFAULT_MODEL=claude-opus-5-5
GATE_AI_FAST_MODEL=claude-haiku-5-5

# ---- Meetings (optional) ----
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=                     # (secret)
ZOOM_USER_ID=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=                       # (secret)
MS_ORGANIZER_USER_ID=

# ---- CRM (optional) ----
HUBSPOT_ACCESS_TOKEN=                   # (secret)

# ---- Scheduler ----
GATE_SCHEDULER_INTERVAL_MS=300000

# ---- Backups (enable with: docker compose --profile backup up -d) ----
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_PASSPHRASE=                      # (secret) encrypts dumps at rest; keep a copy offline
BACKUP_S3_ENDPOINT=                     # e.g. https://<account>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=gate/postgres
BACKUP_S3_ACCESS_KEY_ID=                # (secret)
BACKUP_S3_SECRET_ACCESS_KEY=            # (secret)
