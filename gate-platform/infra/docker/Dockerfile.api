# syntax=docker/dockerfile:1.7
# Gate API image: Fastify server + in-process scheduler + embeddable widget bundle.
# Build context is the gate-platform directory:
#   docker build -f infra/docker/Dockerfile.api -t gate-api .

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable && apk add --no-cache libc6-compat
WORKDIR /app

# ---- dependencies: only manifests, so the install layer is cached across code changes
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/mcp/package.json apps/mcp/
COPY apps/widget/package.json apps/widget/
COPY packages/ai-gateway/package.json packages/ai-gateway/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/integrations-hubspot/package.json packages/integrations-hubspot/
COPY packages/ledger/package.json packages/ledger/
COPY packages/meetings/package.json packages/meetings/
COPY packages/payments-stripe/package.json packages/payments-stripe/
COPY packages/pricing/package.json packages/pricing/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @gate/api... --filter @gate/widget...

# ---- build: compile the API, its workspace packages and the widget bundle
FROM deps AS build
COPY apps/api apps/api
COPY apps/mcp apps/mcp
COPY apps/widget apps/widget
COPY packages packages
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm turbo run build --filter=@gate/api... --filter=@gate/widget \
 # Drop dev dependencies but keep the workspace links (pnpm prune rebuilds the tree from the
 # root and loses apps/api/node_modules/@gate/*; a filtered prod install does not).
 && pnpm install --prod --frozen-lockfile --prefer-offline --filter @gate/api... --filter @gate/widget... \
 && find apps packages -type d \( -name src -o -name test -o -name __tests__ \) -prune -exec rm -rf {} + \
 && rm -rf .turbo apps/*/.turbo packages/*/.turbo \
 && test -L apps/api/node_modules/@gate/ledger && test -f packages/ledger/dist/index.js

# ---- runtime
FROM node:22-alpine AS runtime
ENV NODE_ENV=production GATE_ENV=production PORT=4000
RUN apk add --no-cache curl tini && addgroup -S gate && adduser -S gate -G gate
WORKDIR /app
COPY --from=build --chown=gate:gate /app /app
# Course images; mounted as the "media" volume in production so they survive redeploys.
RUN mkdir -p /data/media && chown -R gate:gate /data
USER gate
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:4000/health || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/api/dist/main.js"]
