# API
PORT=4000
GATE_ENV=development
# Postgres (omit to run fully in-memory)
DATABASE_URL=postgres://gate:gate@localhost:5432/gate
# Stripe (omit to use the in-process fake payments adapter)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Bootstrap API key for the first organization (dev only)
GATE_BOOTSTRAP_API_KEY=dev_key_change_me
# AI gateway (Anthropic first-party is the default provider)
ANTHROPIC_API_KEY=
GATE_AI_DEFAULT_MODEL=claude-opus-5-5
GATE_AI_FAST_MODEL=claude-haiku-5-5
# Web
NEXT_PUBLIC_GATE_API_URL=http://localhost:4000
NEXT_PUBLIC_GATE_API_KEY=dev_key_change_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
