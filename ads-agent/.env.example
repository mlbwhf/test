# Ads Agent configuration. On the VPS this lives at /opt/ads-agent/.env (chmod 600).
# NEVER commit a filled-in .env to git. Use read-only / least-privilege keys everywhere.

# --- Ground truth: website payments (Stripe) ---
# Restricted key, READ-ONLY on Charges + Checkout Sessions:
#   Stripe Dashboard > Developers > API keys > Create restricted key
# Only payments marked origin=agile-agilist.com (or whose checkout returns to the site) count for ads.
STRIPE_API_KEY=rk_live_paste_restricted_read_only_key
# Optional: Corsizio's Stripe Connect application id (ca_...), to label its payments "corsizio"
# (Stripe Dashboard > Settings > Connected platforms). Unset = labelled "stripe_other".
CORSIZIO_STRIPE_APPLICATION=

# --- Ground truth: Eventbrite ---
EVENTBRITE_TOKEN=paste_private_token_here
EVENTBRITE_ORG_ID=paste_org_id

# --- Agent store: Airtable "Ads Agent" base ---
# Personal access token scoped to ONLY this base: data.records:read + data.records:write
AIRTABLE_TOKEN=pat_paste_token
AIRTABLE_BASE_ID=appCXSWnIISm0c6iF

# --- Google Ads spend (written by scripts/google_ads_daily_spend.gs) ---
# Sheet > File > Share > Publish to web > tab "GoogleAdsSpend" > CSV > copy link
GOOGLE_ADS_SPEND_CSV_URL=https://docs.google.com/spreadsheets/d/e/PASTE/pub?gid=PASTE&single=true&output=csv
# Campaign-name fragments that mark a BRAND campaign (for the CPC leakage tripwire)
BRAND_CAMPAIGN_PATTERNS=defense,brand

# --- Alerts & weekly report (SMTP; Gmail needs an app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=paste_sender_address
SMTP_PASSWORD=paste_app_password
ALERT_FROM=paste_sender_address
ALERT_TO=mark@agile-agilist.com

# --- Weekly analysis LLM ---
LLM_PROVIDER=groq
GROQ_API_KEY=paste_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
# Only if LLM_PROVIDER=anthropic (and add `anthropic` to requirements.txt):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

BUSINESS_TZ=America/Toronto

# --- Microsoft Ads (not wired into the daily run yet; needs the one-time OAuth) ---
MS_ADS_DEVELOPER_TOKEN=paste_developer_token_here
MS_ADS_CLIENT_ID=azure_app_registration_needed
MS_ADS_CLIENT_SECRET=azure_app_registration_needed
MS_ADS_REFRESH_TOKEN=oauth_flow_output
MS_ADS_CUSTOMER_ID=187136875
