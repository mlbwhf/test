    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the format and passing score of the SAFe Practice Consultant (SPC) exam?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The SPC examination is a web-based, closed-book, 120-minute timed test of 60 multiple-choice and multiple-select questions. Candidates must achieve an 83% passing score — 50 of 60 correct — to unlock the official credential."
          }
        },
        {
          "@type": "Question",
          "name": "Why is internal SPC training critical for corporate Agile transformations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "External consulting interventions rarely stick long-term without an internal guiding coalition. Training internal change agents ensures that custom value streams, DevOps pipelines, and continuous-delivery methods are sustained by leaders embedded permanently within the corporate structure."
          }
        },
        {
          "@type": "Question",
          "name": "Who is this course designed for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Implementing SAFe course is designed for experienced Agile practitioners, enterprise coaches, transformation leads, senior Scrum Masters, Release Train Engineers, and internal change-management professionals preparing to lead or sustain a SAFe transformation at program or portfolio scale. It is not an introductory Agile course."
          }
        },
        {
          "@type": "Question",
          "name": "What are the prerequisites?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Five or more years of experience in software development, IT, or business transformation, including exposure to Agile at the team level, is recommended. No formal pre-certification is required to attend, though completing the SAFe for Teams or POPM course beforehand materially improves the learning experience."
          }
        },
        {
          "@type": "Question",
          "name": "How does the SPC certification renewal work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The SPC certification is valid for one year. Renewal requires earning continuing education units through SAFe events, SAFe Studio learning paths, community contribution, or a refresher course, managed through the Scaled Agile Community Portal."
          }
        },
        {
          "@type": "Question",
          "name": "Can SPCs deliver SAFe courses to external clients?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Certified SPCs who become Scaled Agile Partners are authorised to deliver public and private SAFe courses to external organisations under the partnership agreement and licensing terms."
          }
        },
        {
          "@type": "Question",
          "name": "Is the course available virtually as well as in person?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both modalities are offered. Virtual delivery uses collaborative facilitation tooling such as digital PI Planning boards and breakout environments to replicate in-person simulation fidelity. Class sizes are kept deliberately small in both formats."
          }
        },
        {
          "@type": "Question",
          "name": "What differentiates this delivery from other providers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Instruction is provided by an SPCT, not a certified SPC acting as facilitator. The SPCT tier is held by fewer than 200 practitioners globally, so debriefs, coaching conversations, and roadmapping exercises draw on a substantially deeper reference set than standard SPC-led delivery."
          }
        }
      ]
    }
  ]
}