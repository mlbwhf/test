    {
      "@type": "Course",
      "name": "Advanced SAFe Practice Consultant (ASPC) Certification",
      "description": "Advanced, SPCT-led certification for practicing SPCs leading multi-train value streams, portfolio governance, and AI-Native, AI Automation, and Mutation dimensions in enterprise SAFe transformations. Assessed across seven competency dimensions.",
      "provider": {
        "@type": "Organization",
        "name": "Implementing SAFe",
