    "content": "<!-- wp:navigation {\"ref\":REPLACE_WITH_wp_navigation_ID,\"overlayMenu\":\"mobile\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} /-->\n<!-- wp:cover {\"url\":\"https://picsum.photos/seed/brewhero/1600/900\",\"dimRatio\":50,\"overlayColor\":\"navy\",\"align\":\"full\",\"minHeight\":540} --><div class=\"wp-block-cover alignfull\" style=\"min-height:540px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-navy-background-color has-background-dim\"></span><img class=\"wp-block-cover__image-background\" alt=\"Brew-n-Chill Robo-Barista\" src=\"https://picsum.photos/seed/brewhero/1600/900\" data-object-fit=\"cover\"/><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"textAlign\":\"center\",\"level\":1,\"textColor\":\"white\",\"fontSize\":\"hero\"} --><h1 class=\"wp-block-heading has-text-align-center has-white-color has-text-color has-hero-font-size\">Coffee and ice cream. From one robot. 24/7.</h1><!-- /wp:heading --><!-- wp:paragraph {\"align\":\"center\",\"textColor\":\"cream\",\"fontSize\":\"medium\"} --><p class=\"has-text-align-center has-cream-color has-text-color has-medium-font-size\">The Brew-n-Chill Robo-Barista serves barista-grade coffee AND soft-serve ice cream in under 60 seconds \u2014 for offices, gyms, hotels, malls and campuses.</p><!-- /wp:paragraph --><!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --><div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"teal\",\"textColor\":\"white\"} --><div class=\"wp-block-button\"><a class=\"wp-block-button__link has-teal-background-color has-white-color has-text-color has-background wp-element-button\" href=\"/contact/\">Book a Free Demo</a></div><!-- /wp:button --><!-- wp:button {\"backgroundColor\":\"teal-bright\",\"textColor\":\"white\"} --><div class=\"wp-block-button\"><a class=\"wp-block-button__link has-teal-bright-background-color has-white-color has-text-color has-background wp-element-button\" href=\"/machines/\">Meet the Robo-Barista</a></div><!-- /wp:button --></div><!-- /wp:buttons --></div></div><!-- /wp:cover -->\n<!-- wp:group { \"align\":\"full\",\"backgroundColor\":\"white\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull has-white-background-color has-background\"><!-- wp:heading {\"level\":2,\"textColor\":\"navy\",\"fontSize\":\"x-large\"} --><h2 class=\"wp-block-heading has-navy-color has-text-color has-x-large-font-size\">One machine, two cravings</h2><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\",\"fontSize\":\"medium\",\"align\":\"center\"} --><p class=\"has-muted-color has-text-color has-medium-font-size has-text-align-center\">The name is the menu. <strong>Brew</strong> the coffee, <strong>Chill</strong> with ice cream \u2014 both poured by the same robot, both on our own Brew-n-Chill brand.</p><!-- /wp:paragraph --><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group { \"align\":\"full\",\"backgroundColor\":\"teal-soft\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull has-teal-soft-background-color has-background\"><!-- wp:heading {\"level\":3,\"textColor\":\"navy\"} --><h3 class=\"wp-block-heading has-navy-color has-text-color\">\u2615 Brew</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Espresso, latte, cappuccino, cold brew \u2014 specialty beans dialled in for the machine.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:group { \"align\":\"full\",\"backgroundColor\":\"cream\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull has-cream-background-color has-background\"><!-- wp:heading {\"level\":3,\"textColor\":\"teal\"} --><h3 class=\"wp-block-heading has-teal-color has-text-color\">\ud83c\udf66 Chill</h3><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\"} --><p class=\"has-muted-color has-text-color\">Soft-serve ice cream, frozen treats, iced refreshers \u2014 a second profit centre from the same footprint.</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --></div><!-- /wp:group -->\n<!-- wp:group { \"align\":\"full\",\"backgroundColor\":\"cream\",\"layout\":{\"type\":\"constrained\"}} --><div class=\"wp-block-group alignfull has-cream-background-color has-background\"><!-- wp:columns {\"align\":\"wide\"} --><div class=\"wp-block-columns alignwide\"><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":2,\"textColor\":\"teal\",\"fontSize\":\"xx-large\"} --><h2 class=\"wp-block-heading has-teal-color has-text-color has-xx-large-font-size\">60 sec</h2><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\",\"align\":\"center\"} --><p class=\"has-muted-color has-text-color has-text-align-center\">From tap to finished serve.</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":2,\"textColor\":\"teal\",\"fontSize\":\"xx-large\"} --><h2 class=\"wp-block-heading has-teal-color has-text-color has-xx-large-font-size\">24/7</h2><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\",\"align\":\"center\"} --><p class=\"has-muted-color has-text-color has-text-align-center\">Self-serve, unattended, every hour.</p><!-- /wp:paragraph --></div><!-- /wp:column --><!-- wp:column --><div class=\"wp-block-column\"><!-- wp:heading {\"level\":2,\"textColor\":\"teal\",\"fontSize\":\"xx-large\"} --><h2 class=\"wp-block-heading has-teal-color has-text-color has-xx-large-font-size\">~2 m\u00b2</h2><!-- /wp:heading --><!-- wp:paragraph {\"textColor\":\"muted\",\"align\":\"center\"} --><p class=\"has-muted-color has-text-color has-text-align-center\">Coffee bar + ice-cream stand in one tiny footprint.</p><!--